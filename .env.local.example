# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Orthodontic version unlock overrides (HMAC secret)
OVERRIDE_TOKEN_SECRET=

# Co-browsing support relay (standalone socket server, see server/support-socket.js).
# Point this at the deployed relay (https://your-relay-host:4000) so users OUTSIDE
# localhost can be serviced. When unset, the app falls back to the current
# origin's hostname on port 4000 (same protocol, so no mixed content).
NEXT_PUBLIC_SOCKET_SERVER_URL=

# Calendario overhaul — RBC edition (Phase 0 feature flag; flips true once
# the React-Big-Calendar shell lands in Phase 1). fallback = current Dashboard.
NEXT_PUBLIC_USE_NEW_CALENDARIO=false

# Phase 5 — VAPID web push (generate keys: node scripts/generate-vapid.mjs apply)
# The _1 suffix matches the production vars already configured in Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY_1=
VAPID_PRIVATE_KEY_1=
VAPID_SUBJECT=mailto:admin@diamondlink.app

# Shared secret for the Supabase pg_net webhook that triggers chat push when no
# tab is open. Must match the _secret value in the SQL migration.
PUSH_WEBHOOK_SECRET=

# Phase 5b — secret gate for the /api/cron/reminders dispatcher (Vercel Cron
# also sends x-vercel-cron:1). Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Phase 5b — how many minutes early the dispatcher treats reminders as due, to
# compensate for GitHub Actions cron lag (~5). Optional; defaults to 5.
# REMINDER_LEAN_MINUTES=5

# CardDAV sync — shared token gate for GET/PROPFIND/OPTIONS /api/dav/contacts.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Auth is per-user (never a global dump). Valid credentials:
#   - Authorization: Bearer <Clerk session JWT>  (scopes to that Clerk user)
#   - Authorization: Basic base64(user_id:DAV_SYNC_TOKEN)
#   - ?user_id=<id>&token=<DAV_SYNC_TOKEN>
# There is no anonymous/anon-key fallback.
DAV_SYNC_TOKEN=
